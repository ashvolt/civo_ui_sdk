# Get a key at https://relax.ai — it is read on the server only and must never
# be exposed to the browser (no NEXT_PUBLIC_ prefix).
RELAX_API_KEY=

# Optional. Defaults to https://api.relax.ai/v1. The SDK refuses any host that
# is not on its sovereignty allowlist, so this cannot silently point elsewhere.
# RELAX_BASE_URL=https://api.relax.ai/v1

# Optional. Defaults to Llama-4-Maverick-17B-128E.
# RELAX_MODEL=DeepSeek-V31-Terminus
