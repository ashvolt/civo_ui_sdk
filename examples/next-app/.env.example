# ---------------------------------------------------------------------------
# Which endpoint the demo talks to. `relaxai` (default) or `ollama`.
# ---------------------------------------------------------------------------
# RELAX_UI_PROVIDER=relaxai

# --- relaxAI (the default, and the point of the SDK) ------------------------
# Get a key at https://relax.ai. Read on the server only — never prefix a key
# with NEXT_PUBLIC_, which would ship it to every browser that loads the page.
RELAX_API_KEY=

# Optional. Defaults to https://api.relax.ai/v1. The sovereignty guard refuses
# any host not on its allowlist, so this cannot silently point elsewhere.
# RELAX_BASE_URL=https://api.relax.ai/v1

# Optional. Defaults to Llama-4-Maverick-17B-128E.
# RELAX_MODEL=DeepSeek-V31-Terminus

# --- local Ollama (demo only; NOT a sovereign endpoint) ---------------------
# Set RELAX_UI_PROVIDER=ollama to run the demo with no relaxAI account at all.
# The sovereignty guard still runs — it is handed a loopback-only policy, so it
# will refuse any non-loopback host exactly as it would in production. The UI
# says plainly that you are not on a sovereign endpoint.
#
# No API key is needed in this mode.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#
# Leave unset to auto-pick from whatever `ollama list` shows. The pick favours
# SMALL models — roughly the 3b-9b band, so a 4b or 7b wins over a 32b — and
# among those, ones whose family ships a tool template. A demo wants the
# smallest model that can still do the job, not the most capable one installed.
# Set this to pin a specific model.
# OLLAMA_MODEL=qwen3:4b
