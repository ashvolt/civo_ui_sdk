{
  "name": "relax-ui-render",
  "version": "0.1.0",
  "description": "The framework-neutral render core for the relaxAI Generative UI SDK: contract-only resolution, validation by trust tier, lazy loading, and a keyed DOM reconciler built on the protocol's structural sharing. No dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "relax-ui-protocol": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
