  "dependencies": { "@civo/relax-ui-core": "workspace:^" },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0", "zod": "^3.23.0 || ^4.0.0" },
  "devDependencies": { "@types/react": "^19.0.2", "react": "^19.0.0", "tsup": "^8.3.5", "typescript": "^5.7.2", "zod": "^3.24.1" },
  "publishConfig": { "access": "public" }
