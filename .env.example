# Copy to `.env` (which is gitignored) and fill in. `pnpm probe` loads this
# automatically, so the key never has to go on a command line or into shell
# history.
#
# Get a key at https://relax.ai
RELAX_API_KEY=

# Optional. Defaults to https://api.relax.ai/v1. The SDK refuses any host that
# is not on its sovereignty allowlist, so this cannot silently point elsewhere.
# RELAX_BASE_URL=https://api.relax.ai/v1
