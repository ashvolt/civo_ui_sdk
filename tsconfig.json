{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "relax-ui-protocol": ["packages/protocol/src/index.ts"],
      "relax-ui-contract": ["packages/contract/src/index.ts"],
      "relax-ui-theme-base": ["packages/theme-base/src/index.ts"],
      "relax-ui-render": ["packages/render/src/index.ts"],
      "relax-ui-element": ["packages/element/src/index.ts"],
      "relax-ui-connect-react": ["packages/connect-react/src/index.ts"],
      "relax-ui-connect-vue": ["packages/connect-vue/src/index.ts"],
      "relax-ui-connect-angular": ["packages/connect-angular/src/index.ts"],
      "relax-ui-core": ["packages/core/src/index.ts"],
      "relax-ui-core/*": ["packages/core/src/*"],
      "relax-ui-react": ["packages/react/src/index.ts"],
      "relax-ui-next": ["packages/next/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/samples/**/*.ts",
    "packages/*/samples/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "examples"]
}
